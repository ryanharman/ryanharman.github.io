---
import { getCollection } from "astro:content";
import FormattedDate from "../../components/FormattedDate.astro";
import Layout from "../../layouts/Layout.astro";

const posts = (await getCollection("thoughts")).sort(
	(a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
);
---

<Layout currentPage="/thoughts" title="Thoughts - Ryan Harman">
  <section class="space-y-6">
    <h1 class="text-2xl font-medium tracking-tight">My thoughts</h1>
    <ul class="space-y-3">
      {
        posts.length === 0 ? (
          <li>
            <h2 class="tracking-tight font-medium text-tertiary">
              No posts yet. Maybe check another time
            </h2>
          </li>
        ) : (
          posts.map((post) => (
            <li class="flex flex-col gap-1 py-3 sm:flex-row sm:justify-between sm:gap-4">
              <a class="hover:underline" href={`/thoughts/${post.slug}/`}>
                <h2 class="tracking-tight font-medium group-hover:underline">
                  {post.data.title}
                </h2>
              </a>
              <p class="text-tertiary text-sm sm:text-right sm:whitespace-nowrap">
                <FormattedDate date={post.data.publishedAt} />
              </p>
            </li>
          ))
        )
      }
    </ul>
  </section>
</Layout>
