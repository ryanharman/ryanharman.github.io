---
import CvForExport from "../components/CvForExport.astro";
import Layout from "../layouts/Layout.astro";
---

<script>
  // Export uses the browser's native print-to-PDF dialog. This renders the
  // real fonts, keeps text selectable, and works consistently across platforms.
  document.addEventListener("astro:page-load", () => {
    const downloadButton = document.getElementById("download-btn");
    downloadButton?.addEventListener("click", () => window.print());
  });
</script>

<Layout currentPage="/cv" title="CV - Ryan Harman">
  <CvForExport />
  <!-- Clearance so the fixed "Save as PDF" button never overlaps the last CV
       entry when scrolled to the bottom on small screens. -->
  <div class="h-16 print-hidden" aria-hidden="true"></div>
  <button
    id="download-btn"
    class="btn print-hidden fixed bottom-4 right-4 bg-background text-primary shadow-sm group my-4"
  >
    Save as PDF
  </button>
</Layout>
