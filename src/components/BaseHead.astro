---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import "../styles/global.css";
// Self-hosted Geist Sans + Geist Mono (variable). Self-hosting keeps fonts
// fast and renders them reliably in the print/PDF output.
import "@fontsource-variable/geist";
import "@fontsource-variable/geist-mono";
import { ClientRouter } from "astro:transitions";
import { AUTHOR, SITE_DESCRIPTION } from "../consts";

interface Props {
	title: string;
	description: string;
	image?: string;
	// When set, the page also emits BlogPosting + BreadcrumbList structured data.
	article?: { title: string; publishedAt: Date; tags?: string[] } | undefined;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// Per-page social-share card generated by src/pages/og/[...route].ts. The route
// key mirrors the pathname (home for "/", "thoughts/<slug>" for a post), so the
// image defaults to the matching card unless a caller passes one explicitly.
const path = Astro.url.pathname.replace(/^\/+|\/+$/g, "");
const ogKey = path === "" ? "home" : path;

const { title, description, image = `/og/${ogKey}.png`, article } = Astro.props;

// Origin without a trailing path, e.g. "https://ryanharman.dev".
const origin = Astro.site?.origin ?? "https://ryanharman.dev";

// schema.org graph. Person + WebSite render on every page so search engines can
// build a consistent identity for "Ryan Harman"; posts add Article + breadcrumb.
const person = {
	"@type": "Person",
	"@id": `${origin}/#person`,
	name: AUTHOR.name,
	jobTitle: AUTHOR.jobTitle,
	url: `${origin}/`,
	email: `mailto:${AUTHOR.email}`,
	address: {
		"@type": "PostalAddress",
		addressLocality: AUTHOR.location.city,
		addressCountry: AUTHOR.location.countryCode,
	},
	sameAs: AUTHOR.sameAs,
	knowsAbout: AUTHOR.knowsAbout,
};

const website = {
	"@type": "WebSite",
	"@id": `${origin}/#website`,
	url: `${origin}/`,
	name: AUTHOR.name,
	description: SITE_DESCRIPTION,
	publisher: { "@id": `${origin}/#person` },
};

const graph: Record<string, unknown>[] = [person, website];

if (article) {
	graph.push({
		"@type": "BlogPosting",
		"@id": `${canonicalURL.href}#article`,
		headline: article.title,
		description,
		datePublished: article.publishedAt.toISOString(),
		author: { "@id": `${origin}/#person` },
		publisher: { "@id": `${origin}/#person` },
		mainEntityOfPage: canonicalURL.href,
		url: canonicalURL.href,
		...(article.tags?.length ? { keywords: article.tags.join(", ") } : {}),
	});
	graph.push({
		"@type": "BreadcrumbList",
		itemListElement: [
			{ "@type": "ListItem", position: 1, name: "Home", item: `${origin}/` },
			{
				"@type": "ListItem",
				position: 2,
				name: "Thoughts",
				item: `${origin}/thoughts/`,
			},
			{ "@type": "ListItem", position: 3, name: article.title },
		],
	});
}

const jsonLd = { "@context": "https://schema.org", "@graph": graph };
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="generator" content={Astro.generator} />

<!-- Icons / favicons (SVG for modern browsers, .ico fallback, Apple + PWA) -->
<link rel="icon" href="/favicon.ico" sizes="32x32" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
<meta name="theme-color" content="#18181b" />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={article ? "article" : "website"} />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image, Astro.url)} />
<!-- astro-og-canvas renders cards at the OG-standard 1200x630; declaring the
     dimensions lets platforms reserve the right aspect ratio before load. -->
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:type" content="image/png" />
<meta property="og:site_name" content="Ryan Harman" />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={new URL(image, Astro.url)} />

<link
  rel="alternate"
  type="application/rss+xml"
  title={title}
  href={new URL("rss.xml", Astro.site)}
/>
<link rel="sitemap" href="/sitemap-index.xml" />

<!-- Structured data (schema.org) for richer search results -->
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />

<!-- View Transitions for smooth navigation -->
<ClientRouter />
