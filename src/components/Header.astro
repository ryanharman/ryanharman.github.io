---
type Props = {
	currentPage: "/" | "/projects" | "/thoughts" | "/cv" | "/contact";
};

const { currentPage } = Astro.props;

const activeClasses = "border-b border-tertiary/50 text-primary";
const defaultClasses =
	"hover:text-primary cursor-pointer py-1 px-1 hover:transition-none transition-all font-mono leading-tight";
---

<header class="flex gap-4 items-center justify-between">
  <nav>
    <ul class="flex gap-6">
      <li>
        <a
          class={currentPage === "/"
            ? `${activeClasses} ${defaultClasses}`
            : `${defaultClasses} text-secondary`}
          href="/"
        >
          home</a
        >
      </li>
      <li>
        <a
          class={currentPage === "/projects"
            ? `${activeClasses} ${defaultClasses}`
            : `${defaultClasses} text-secondary`}
          href="/projects"
        >
          projects</a
        >
      </li>
      <li>
        <a
          class={currentPage === "/thoughts"
            ? `${activeClasses} ${defaultClasses}`
            : `${defaultClasses} text-secondary`}
          href="/thoughts"
        >
          thoughts</a
        >
      </li>
      <li>
        <a
          class={currentPage === "/cv"
            ? `${activeClasses} ${defaultClasses}`
            : `${defaultClasses} text-secondary`}
          href="/cv"
        >
          cv</a
        >
      </li>
      <li>
        <a
          class={currentPage === "/contact"
            ? `${activeClasses} ${defaultClasses}`
            : `${defaultClasses} text-secondary`}
          href="/contact"
        >
          contact</a
        >
      </li>
    </ul>
  </nav>
  <slot />
</header>
