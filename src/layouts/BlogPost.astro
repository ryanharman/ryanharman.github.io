---
import type { CollectionEntry } from "astro:content";
import FormattedDate from "../components/FormattedDate.astro";
import Layout from "./Layout.astro";

type Props = CollectionEntry<"thoughts">["data"];

const { title, description, publishedAt, tags } = Astro.props;
---

<Layout
  currentPage="/thoughts"
  title={`${title} - Ryan Harman`}
  description={description}
  article={{ title, publishedAt, tags }}
>
  <div class="max-w-prose">
    <div class="flex flex-col gap-1 mb-2 sm:flex-row sm:justify-between sm:gap-4">
      <div>
        <h2 class="text-primary text-2xl font-medium mb-2">{title}</h2>
      </div>
      <p class="text-tertiary text-sm sm:mt-2 sm:text-right sm:whitespace-nowrap">
        <FormattedDate date={publishedAt} />
      </p>
    </div>
    <p class="text-secondary">{description}</p>
  </div>
  <slot />
</Layout>
